{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "backend.api:app", "--port", "8000", "--loop", "asyncio:SelectorEventLoop"],
      "port": 8000
    },
    {
      "name": "ui",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "streamlit", "run", "frontend/app.py", "--server.headless", "true", "--server.port", "8501"],
      "port": 8501
    }
  ]
}
